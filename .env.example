# Copy to .env.local (never commit it)

# Supabase project: Dashboard -> Project Settings -> API
SUPABASE_URL=
# Publishable (anon) key: safe to expose; used with each user's own session, so row-level security applies.
SUPABASE_PUBLISHABLE_KEY=
# Secret service-role key: SERVER ONLY, bypasses RLS. Used just for the shared market-data cache. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for POST /api/cron/eod (end-of-day price snapshot). Generate: openssl rand -hex 16
CRON_SECRET=
